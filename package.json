{
  "name": "ict-forward-lab",
  "version": "0.1.0",
  "private": true,
  "description": "ICT Forward Lab — BTCUSDT Futures forward-testing system",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @ict-forward-lab/api run dev",
    "dev:web": "pnpm --filter @ict-forward-lab/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
