NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ict_forward_lab

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001

# Web
WEB_PORT=3000

# Exchange (for future use)
EXCHANGE=binance
SYMBOL=BTCUSDT

# WebSocket URLs (for future use)
BINANCE_WS_URL=wss://fstream.binance.com/ws
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Forward Test Config (read by apps/api plugins/forward-test.ts)
FORWARD_TEST_INITIAL_BALANCE=10000
FORWARD_TEST_RISK_PER_TRADE_PERCENT=1
FORWARD_TEST_FEE_PERCENT=0.04
FORWARD_TEST_SLIPPAGE_PERCENT=0.02
FORWARD_TEST_MAX_OPEN_TRADES=1
FORWARD_TEST_MAX_TRADES_PER_DAY=3
FORWARD_TEST_MIN_RR=2
FORWARD_TEST_TIMEOUT_CANDLES=24
FORWARD_TEST_MAX_LEVERAGE=10

# Phase 2 — Live Market Data
BINANCE_WS_URL=wss://fstream.binance.com/ws
MARKET_SYMBOL=BTCUSDT
MARKET_TIMEFRAMES=5m,15m,1h,4h
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# API access control (consumed by apps/api). Leave API_KEY empty for open dev
# mode; set it to require an `x-api-key` header on every non-public request.
API_KEY=
CORS_ORIGINS=*
API_PUBLIC_URL=http://localhost:3001

# MCP server (apps/mcp) — points the agent bridge at the API above.
# Set API_KEY here too if the API requires it.
API_BASE_URL=http://localhost:3001

# Human login for the web app (single user). Leave AUTH_PASSWORD_HASH empty to
# disable. Generate a hash:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string
# Turn the web-app page gate on (also set AUTH_PASSWORD_HASH above):
WEB_REQUIRE_LOGIN=false
NEXT_PUBLIC_REQUIRE_LOGIN=false
