# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` before running:  cp .env.example .env
#
#  PRODUCTION CHECKLIST (a public VPS is internet-reachable — do all of these):
#    [ ] API_KEY            set to a long random secret (locks the REST API)
#    [ ] CORS_ORIGINS       set to your web origin(s), NOT *
#    [ ] AUTH_PASSWORD_HASH set + WEB_REQUIRE_LOGIN=true (gate the web UI)
#    [ ] AUTH_COOKIE_SECRET replace with a long random string
#    [ ] DATABASE_URL       use a strong DB password, not postgres/postgres
#    [ ] NODE_ENV=production
#  Prefer keeping the API off the public internet entirely (WireGuard/Tailscale).
#  See docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Database
# Host-run dev points at the docker-mapped port 5433. Inside docker-compose the
# `api` service overrides this to postgres:5432 automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ict_forward_lab

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001

# Web
WEB_PORT=3000

# Exchange (for future use)
EXCHANGE=binance
SYMBOL=BTCUSDT

# WebSocket URLs (for future use)
BINANCE_WS_URL=wss://fstream.binance.com/ws
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Forward Test Config (read by apps/api plugins/forward-test.ts)
FORWARD_TEST_INITIAL_BALANCE=10000
FORWARD_TEST_RISK_PER_TRADE_PERCENT=1
FORWARD_TEST_FEE_PERCENT=0.04
FORWARD_TEST_SLIPPAGE_PERCENT=0.02
FORWARD_TEST_MAX_OPEN_TRADES=1
FORWARD_TEST_MAX_TRADES_PER_DAY=3
FORWARD_TEST_MIN_RR=2
FORWARD_TEST_TIMEOUT_CANDLES=24
FORWARD_TEST_MAX_LEVERAGE=10

# Phase 2 — Live Market Data
BINANCE_WS_URL=wss://fstream.binance.com/ws
MARKET_SYMBOL=BTCUSDT
MARKET_TIMEFRAMES=5m,15m,1h,4h
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# API access control (consumed by apps/api). Empty API_KEY = OPEN mode (no auth)
# — fine for localhost, NEVER on a public VPS. Set it to require an `x-api-key`
# header on every non-public request (decision-packet, calibration, etc.).
API_KEY=
# Comma-separated allowed browser origins. `*` is dev-only; in production set it
# to your web origin, e.g. https://lab.example.com
CORS_ORIGINS=*
API_PUBLIC_URL=http://localhost:3001

# Where the Next web server proxies /api/* (server-side, read at startup).
# Host dev: http://localhost:3001 ; docker-compose sets this to http://api:3001.
API_PROXY_TARGET=http://localhost:3001

# MCP server (apps/mcp) — points the agent bridge at the API above.
# Set API_KEY here too if the API requires it.
API_BASE_URL=http://localhost:3001

# Human login for the web app (single user). Leave AUTH_PASSWORD_HASH empty to
# disable. Generate a hash:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string
# Turn the web-app page gate on (also set AUTH_PASSWORD_HASH above):
WEB_REQUIRE_LOGIN=false
NEXT_PUBLIC_REQUIRE_LOGIN=false
