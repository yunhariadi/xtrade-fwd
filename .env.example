# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` before running:  cp .env.example .env
#
#  PRODUCTION CHECKLIST (a public VPS is internet-reachable — do all of these):
#    [ ] API_KEY            set to a long random secret (locks the REST API)
#    [ ] CORS_ORIGINS       set to your web origin(s), NOT *
#    [ ] AUTH_PASSWORD_HASH set + WEB_REQUIRE_LOGIN=true (gate the web UI)
#    [ ] AUTH_COOKIE_SECRET replace with a long random string
#    [ ] DATABASE_URL       use a strong DB password, not postgres/postgres
#    [ ] NODE_ENV=production
#  Prefer keeping the API off the public internet entirely (WireGuard/Tailscale).
#  See docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Database
# Host-run dev points at the docker-mapped port 5433. Inside docker-compose the
# `api` service overrides this to postgres:5432 automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ict_forward_lab

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001

# Web
WEB_PORT=3000

# ── Front door (Caddy reverse proxy) ─────────────────────────────────────────
# SITE_ADDRESS picks the mode. Everything is served from one origin:
#   SITE/        web app
#   SITE/api/*   REST API   (browser + Hermes-Agent, send x-api-key)
#   SITE/ws      market-data WebSocket
#
# IP-only (no domain, plain HTTP on port 80) — use this for now:
SITE_ADDRESS=:80
# Later, with a real domain → auto-HTTPS (needs DNS pointing here + ports 80/443):
#   SITE_ADDRESS=lab.example.com
ACME_EMAIL=you@example.com

# Exchange (for future use)
EXCHANGE=binance
SYMBOL=BTCUSDT

# WebSocket URLs (for future use)
BINANCE_WS_URL=wss://fstream.binance.com/ws
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Forward Test Config (read by apps/api plugins/forward-test.ts)
FORWARD_TEST_INITIAL_BALANCE=10000
FORWARD_TEST_RISK_PER_TRADE_PERCENT=1
FORWARD_TEST_FEE_PERCENT=0.04
FORWARD_TEST_SLIPPAGE_PERCENT=0.02
FORWARD_TEST_MAX_OPEN_TRADES=1
FORWARD_TEST_MAX_TRADES_PER_DAY=3
FORWARD_TEST_MIN_RR=2
FORWARD_TEST_TIMEOUT_CANDLES=24
FORWARD_TEST_MAX_LEVERAGE=10
# Confluence gating on trade creation (signals still fire/broadcast; only trade
# creation is gated). Score buckets: <50 ignore, 50-64 monitor, 65-69 internal,
# 70+ actionable. Set MIN_SETUP_SCORE=0 to disable score gating.
# 80 chosen from calibration run 4 (Jan-Jul 2026): 70-79 bucket underperformed
# even <50; 80+ was the best bucket by both win rate and avg R.
FORWARD_TEST_MIN_SETUP_SCORE=80
# Only take trades inside the London Open / New York killzones.
FORWARD_TEST_REQUIRE_KILLZONE=true
# Reject longs in premium and shorts in discount (equilibrium passes both).
FORWARD_TEST_REQUIRE_PREMIUM_DISCOUNT=true

# Phase 2 — Live Market Data
# Source of live candles + REST backfill. Use "bybit" if Binance blocks your
# VPS region/IP (symptom: WS connects + subscribe ack, but zero kline data).
MARKET_SOURCE=binance
BINANCE_WS_URL=wss://fstream.binance.com/ws
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
MARKET_SYMBOL=BTCUSDT
# 1d,1w feed the daily/weekly structure + premium-discount analysis.
MARKET_TIMEFRAMES=5m,15m,1h,4h,1d,1w
# Baked into the browser bundle at BUILD time (rebuild web to change it). Points
# the browser at the public WS endpoint through Caddy (port 80 in IP mode):
#   IP / HTTP  → ws://<VPS_IP>/ws
#   domain TLS → wss://lab.example.com/ws   (https page must use wss://)
# Host-run dev (no proxy) uses ws://localhost:3001/ws.
NEXT_PUBLIC_WS_URL=ws://203.0.113.10/ws

# API access control (consumed by apps/api). Empty API_KEY = OPEN mode (no auth)
# — fine for localhost, NEVER on a public VPS. Set it to require an `x-api-key`
# header on every non-public request (decision-packet, calibration, etc.).
API_KEY=
# Comma-separated allowed browser origins. `*` is dev-only; set it to your web
# origin — http://<VPS_IP> for IP mode, or https://lab.example.com with a domain.
CORS_ORIGINS=http://203.0.113.10
API_PUBLIC_URL=http://203.0.113.10

# Where the Next web server proxies /api/* (server-side, read at startup).
# Host dev: http://localhost:3001 ; docker-compose sets this to http://api:3001.
API_PROXY_TARGET=http://localhost:3001

# MCP server (apps/mcp) — points the agent bridge at the API above. On the
# Hermes-Agent VPS, set this to the public address and use the SAME API_KEY:
#   API_BASE_URL=http://203.0.113.10        (IP mode)
#   API_BASE_URL=https://lab.example.com    (domain mode)
# Locally it's http://localhost:3001.
API_BASE_URL=http://localhost:3001

# Human login for the web app (single user). Leave AUTH_PASSWORD_HASH empty to
# disable. Generate a hash:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'your-password'
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string
# Session cookie Secure flag (HTTPS-only). A Secure cookie is dropped over plain
# http://, so keep this FALSE in IP/HTTP mode (else web login never sticks).
# Flip it to true once you move to a domain with HTTPS.
AUTH_COOKIE_SECURE=false
# Turn the web-app page gate on (also set AUTH_PASSWORD_HASH above):
WEB_REQUIRE_LOGIN=false
NEXT_PUBLIC_REQUIRE_LOGIN=false

# Outbound alert webhook (consumed by apps/api). When a price alert fires, the
# API POSTs the alert:triggered payload to this URL — use it to push alerts to
# another VPS (e.g. Hermes-Agent). Leave empty to disable (WebSocket-only).
#   ALERT_WEBHOOK_URL=https://hermes.example.com/hooks/price-alert
# Optional shared secret, sent as the `x-webhook-secret` request header so the
# receiver can verify the call is genuinely from this API.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
